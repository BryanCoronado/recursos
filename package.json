{
  "name": "recursos-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:seed": "prisma db seed",
    "worker": "tsx worker/index.ts",
    "display:start": "bash scripts/start-display.sh",
