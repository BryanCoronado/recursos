DATABASE_URL="mysql://root:@localhost:3306/recursos_saas"
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Visor noVNC embebido (sync / grabación).
# Mejor: ruta relativa + proxy Nginx (ver scripts/nginx-novnc-snippet.conf)
NEXT_PUBLIC_NOVNC_URL="/vnc/vnc.html"
# Alternativa: http://TU_IP_VPS:6080/vnc.html  (NO uses 127.0.0.1 en producción)

# Solo se usan al ejecutar el seed inicial.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@ejemplo.com"
SEED_ADMIN_PASSWORD="cambia-esta-contrasena-temporal"
